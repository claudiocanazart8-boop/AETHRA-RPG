<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AETHRA — Mapa do Mestre</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Spectral:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#1a1410;
  --ink-2:#241b14;
  --panel:#2a2018;
  --panel-2:#332619;
  --edge:#4a3823;
  --parchment:#e7d9b6;
  --parchment-dim:#c9b98d;
  --gold:#c99a4a;
  --gold-dim:#8a6a34;
  --ember:#b3491f;
  --blood:#7a2e2e;
  --sylvarin:#3f5d43;
  --kharDurim:#5b6b73;
  --varkhan:#b99a5f;
  --morvath:#5a4258;
  --river:#4d7c8e;
  --text-soft:#d8cba9;
  --danger:#c0483c;
  --ok:#5f8a5a;
}
*{box-sizing:border-box;}
html,body{height:100%;margin:0;padding:0;}
body{
  font-family:'Spectral',serif;
  background:var(--ink);
  color:var(--text-soft);
  overflow:hidden;
  height:100vh;
  width:100vw;
  display:flex;
  flex-direction:column;
}
h1,h2,h3,.display{font-family:'Cinzel',serif;letter-spacing:.02em;}
button{font-family:'Spectral',serif;}
::selection{background:var(--gold-dim);}

/* ---------- TOP BAR ---------- */
#topbar{
  display:flex;
  align-items:center;
  gap:14px;
  padding:8px 14px;
  background:linear-gradient(180deg,var(--panel-2),var(--panel));
  border-bottom:2px solid var(--edge);
  flex:0 0 auto;
  z-index:20;
  flex-wrap:wrap;
}
#brand{
  font-family:'Cinzel',serif;
  font-size:20px;
  font-weight:700;
  color:var(--gold);
  letter-spacing:.12em;
  padding-right:10px;
  border-right:1px solid var(--edge);
  margin-right:4px;
}
#brand small{
  display:block;
  font-family:'Spectral',serif;
  font-size:10px;
  color:var(--parchment-dim);
  letter-spacing:.05em;
  font-weight:400;
}
.map-name{
  font-size:14px;
  color:var(--parchment);
  padding:5px 10px;
  background:var(--ink-2);
  border:1px solid var(--edge);
  border-radius:3px;
}
.btn{
  background:var(--panel-2);
  color:var(--text-soft);
  border:1px solid var(--edge);
  padding:6px 12px;
  border-radius:3px;
  cursor:pointer;
  font-size:13px;
  transition:background .12s,border-color .12s;
  white-space:nowrap;
}
.btn:hover{background:var(--edge);border-color:var(--gold-dim);}
.btn:active{transform:translateY(1px);}
.btn.primary{background:var(--gold-dim);border-color:var(--gold);color:#1a1410;font-weight:600;}
.btn.primary:hover{background:var(--gold);}
.btn.danger{border-color:var(--blood);}
.btn.danger:hover{background:var(--blood);color:#fff;}
.btn.on{background:var(--sylvarin);border-color:#6f9a76;color:#eafaea;}
.btn:disabled{opacity:.35;cursor:not-allowed;}
.spacer{flex:1 1 auto;}
#modeToggle{
  display:flex;
  border:1px solid var(--edge);
  border-radius:4px;
  overflow:hidden;
}
#modeToggle button{
  border:none;
  border-radius:0;
  padding:6px 14px;
}
#modeToggle button.active{background:var(--gold);color:#1a1410;font-weight:700;}
#modeToggle button:not(.active){background:var(--ink-2);}

/* ---------- MAIN LAYOUT ---------- */
#main{
  flex:1 1 auto;
  display:flex;
  min-height:0;
}
#toolbar{
  flex:0 0 56px;
  background:var(--panel);
  border-right:2px solid var(--edge);
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:10px 0;
  gap:4px;
  overflow-y:auto;
}
.tool{
  width:40px;height:40px;
  display:flex;align-items:center;justify-content:center;
  background:transparent;
  border:1px solid transparent;
  border-radius:6px;
  color:var(--parchment-dim);
  font-size:19px;
  cursor:pointer;
}
.tool:hover{background:var(--panel-2);color:var(--parchment);}
.tool.active{background:var(--gold-dim);border-color:var(--gold);color:#1a1410;}
.tool:disabled{opacity:.25;cursor:not-allowed;}
.tool-sep{width:28px;height:1px;background:var(--edge);margin:6px 0;}

#stage-wrap{
  flex:1 1 auto;
  position:relative;
  min-width:0;
  background:#0d0906;
  overflow:hidden;
}
#stage{
  display:block;
  width:100%;
  height:100%;
  cursor:grab;
}
#stage.tool-cursor{cursor:crosshair;}
#stage.dragging{cursor:grabbing;}

#hint{
  position:absolute;
  top:10px;left:50%;
  transform:translateX(-50%);
  background:rgba(26,20,16,.85);
  border:1px solid var(--edge);
  color:var(--parchment-dim);
  font-size:12px;
  padding:5px 12px;
  border-radius:3px;
  pointer-events:none;
  z-index:5;
}

/* ---- Moldura decorativa de cartografia (somente Mapa Mundial) ---- */
#mapFrame{
  position:absolute; inset:10px;
  border:2px solid rgba(201,154,74,.55);
  outline:1px solid rgba(201,154,74,.22);
  outline-offset:6px;
  pointer-events:none;
  z-index:4;
}
#mapFrame .corner{
  position:absolute;
  width:30px;height:30px;
  color:rgba(201,154,74,.75);
  font-size:22px;
  line-height:1;
}
#mapFrame .corner.tl{top:-13px;left:-13px;}
#mapFrame .corner.tr{top:-13px;right:-13px;}
#mapFrame .corner.bl{bottom:-13px;left:-13px;}
#mapFrame .corner.br{bottom:-13px;right:-13px;}

#titlePlate{
  position:absolute; top:22px; left:22px;
  z-index:6; pointer-events:none;
  background:linear-gradient(135deg, rgba(26,20,16,.88), rgba(26,20,16,.68));
  border:1px solid rgba(201,154,74,.5);
  border-radius:4px;
  padding:10px 22px 12px;
  max-width:300px;
}
#titlePlate .t1{
  font-family:'Cinzel',serif; font-weight:700; font-size:30px;
  letter-spacing:.16em; color:var(--gold);
  text-shadow:0 2px 6px rgba(0,0,0,.6);
}
#titlePlate .t2{
  font-family:'Cinzel',serif; font-size:11px; letter-spacing:.22em;
  color:var(--parchment-dim); margin-top:2px;
}

#mapQuote{
  position:absolute; top:120px; left:22px;
  z-index:6; pointer-events:none;
  background:rgba(26,20,16,.78);
  border:1px solid rgba(201,154,74,.35);
  border-radius:3px;
  padding:10px 14px;
  max-width:190px;
  font-style:italic; font-size:12px; line-height:1.5;
  color:var(--parchment-dim);
}

#mapCompass{
  position:absolute; top:22px; right:22px;
  z-index:6; pointer-events:none;
  width:84px; height:84px;
}

#mapLegend{
  position:absolute; bottom:22px; right:22px;
  z-index:6; pointer-events:none;
  background:rgba(26,20,16,.85);
  border:1px solid rgba(201,154,74,.45);
  border-radius:4px;
  padding:10px 14px;
  font-size:11.5px;
  color:var(--parchment-dim);
  max-width:190px;
}
#mapLegend h4{
  margin:0 0 6px; font-family:'Cinzel',serif; font-size:12px;
  letter-spacing:.1em; color:var(--gold); text-align:center;
  border-bottom:1px solid rgba(201,154,74,.3); padding-bottom:5px;
}
#mapLegend .lrow{display:flex; align-items:center; gap:7px; margin:3px 0;}
#mapLegend .lrow .sym{width:16px; text-align:center; font-size:12px; flex:0 0 auto;}

#mapScale{
  position:absolute; bottom:22px; left:22px;
  z-index:6; pointer-events:none;
  background:rgba(26,20,16,.78);
  border:1px solid rgba(201,154,74,.35);
  border-radius:3px;
  padding:8px 12px;
  font-size:10.5px;
  color:var(--parchment-dim);
  text-align:center;
}
#mapScale .bar{
  width:120px; height:6px; margin-top:4px;
  background:repeating-linear-gradient(90deg, var(--gold) 0 15px, transparent 15px 30px);
  border:1px solid var(--gold-dim);
}

#rightpanel{
  flex:0 0 268px;
  background:var(--panel);
  border-left:2px solid var(--edge);
  display:flex;
  flex-direction:column;
  overflow-y:auto;
}
.panel-section{
  border-bottom:1px solid var(--edge);
  padding:12px 14px;
}
.panel-section h3{
  font-size:13px;
  margin:0 0 8px 0;
  color:var(--gold);
  text-transform:uppercase;
  letter-spacing:.08em;
}
.layer-row{
  display:flex;align-items:center;justify-content:space-between;
  padding:4px 0;
  font-size:13px;
}
.layer-row label{cursor:pointer;flex:1;}
.switch{
  width:34px;height:18px;
  background:var(--ink-2);
  border:1px solid var(--edge);
  border-radius:10px;
  position:relative;
  cursor:pointer;
  flex:0 0 auto;
}
.switch .knob{
  position:absolute;top:1px;left:1px;
  width:14px;height:14px;border-radius:50%;
  background:var(--parchment-dim);
  transition:left .12s;
}
.switch.on{background:var(--sylvarin);border-color:#6f9a76;}
.switch.on .knob{left:16px;background:#eafaea;}

#objectInfo{font-size:13px;}
#objectInfo .empty{color:var(--parchment-dim);font-style:italic;}
#objectInfo label{display:block;font-size:11px;color:var(--parchment-dim);margin:8px 0 2px;text-transform:uppercase;letter-spacing:.05em;}
#objectInfo input[type=text],#objectInfo textarea,#objectInfo select{
  width:100%;
  background:var(--ink-2);
  border:1px solid var(--edge);
  color:var(--text-soft);
  padding:6px 8px;
  border-radius:3px;
  font-family:'Spectral',serif;
  font-size:13px;
}
#objectInfo textarea{resize:vertical;min-height:50px;}
.row2{display:flex;gap:6px;}
.row2>div{flex:1;}
/* ---------- BOTTOM BAR ---------- */
#bottombar{
  flex:0 0 auto;
  display:flex;
  align-items:center;
  gap:16px;
  padding:6px 14px;
  background:var(--panel-2);
  border-top:2px solid var(--edge);
  font-size:12px;
  color:var(--parchment-dim);
  flex-wrap:wrap;
}
#bottombar .grp{display:flex;align-items:center;gap:6px;}
#zoomSlider{width:120px;accent-color:var(--gold);}
#coords{min-width:130px;}

/* ---------- MODAL ---------- */
#modalOverlay{
  position:fixed;inset:0;
  background:rgba(10,7,5,.72);
  display:none;
  align-items:center;justify-content:center;
  z-index:100;
}
#modalOverlay.show{display:flex;}
#modalBox{
  background:var(--panel);
  border:1px solid var(--gold-dim);
  border-radius:6px;
  padding:20px 22px;
  width:320px;
  max-width:90vw;
}
#modalBox h3{margin:0 0 12px 0;color:var(--gold);font-size:16px;}
#modalBox label{display:block;font-size:11px;color:var(--parchment-dim);margin:10px 0 3px;text-transform:uppercase;letter-spacing:.05em;}
#modalBox input,#modalBox select,#modalBox textarea{
  width:100%;background:var(--ink-2);border:1px solid var(--edge);color:var(--text-soft);
  padding:7px 9px;border-radius:3px;font-family:'Spectral',serif;font-size:13px;
}
#modalBox .modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px;}

/* Token type swatches for the add-token modal */
.type-grid{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;}
.type-chip{
  padding:5px 9px;border:1px solid var(--edge);border-radius:14px;
  font-size:12px;cursor:pointer;background:var(--ink-2);
}
.type-chip.sel{background:var(--gold-dim);color:#1a1410;border-color:var(--gold);font-weight:600;}

.toast{
  position:fixed;bottom:56px;left:50%;transform:translateX(-50%);
  background:var(--gold);color:#1a1410;font-weight:600;font-size:13px;
  padding:8px 16px;border-radius:4px;z-index:200;
  opacity:0;pointer-events:none;transition:opacity .25s;
}
.toast.show{opacity:1;}

@media (max-width:900px){
  #rightpanel{flex-basis:220px;}
  #brand{font-size:16px;}
}
</style>
</head>
<body>

<div id="topbar">
  <div id="brand">AETHRA<small>Mapa do Mestre</small></div>
  <div class="map-name" id="mapNameLabel">Mundo de Aethra</div>
  <button class="btn" id="btnGoWorld" title="Voltar ao mapa mundial">🌍 Mundo</button>
  <div class="spacer"></div>
  <button class="btn" id="btnNew">📄 Novo</button>
  <button class="btn" id="btnSave">💾 Salvar</button>
  <button class="btn" id="btnLoad">📂 Carregar</button>
  <button class="btn" id="btnExport">⬇ Exportar</button>
  <button class="btn" id="btnImport">⬆ Importar</button>
  <input type="file" id="fileImport" accept=".json" style="display:none">
  <button class="btn danger" id="btnReset">↺ Resetar</button>
  <div id="modeToggle">
    <button id="modeGM" class="active">🛡 Mestre</button>
    <button id="modeVocesData">👥 Jogador</button>
  </div>
</div>

<div id="main">
  <div id="toolbar">
    <button class="tool active" data-tool="select" title="Selecionar / Mover mapa">↖</button>
    <button class="tool" data-tool="pan" title="Mover o mapa (Pan)">✋</button>
    <div class="tool-sep"></div>
    <button class="tool" data-tool="draw" title="Desenhar" data-gm="1">✏️</button>
    <button class="tool" data-tool="erase" title="Apagar" data-gm="1">🧹</button>
    <button class="tool" data-tool="line" title="Linha" data-gm="1">📏</button>
    <button class="tool" data-tool="rect" title="Retângulo" data-gm="1">▭</button>
    <button class="tool" data-tool="circle" title="Círculo" data-gm="1">◯</button>
    <div class="tool-sep"></div>
    <button class="tool" data-tool="text" title="Texto" data-gm="1">🔤</button>
    <button class="tool" data-tool="pin" title="Pin / Marcador" data-gm="1">📍</button>
    <button class="tool" data-tool="addToken" title="Adicionar Token">➕</button>
    <div class="tool-sep"></div>
    <button class="tool" data-tool="revealFog" title="Revelar névoa" data-gm="1">🔆</button>
    <button class="tool" data-tool="hideFog" title="Esconder névoa" data-gm="1">🌑</button>
  </div>

  <div id="stage-wrap">
    <canvas id="stage"></canvas>
    <div id="hint">Arraste para mover · Roda do mouse para zoom · Duplo-clique em Brumafria para entrar na vila</div>

    <div id="mapFrame">
      <div class="corner tl">❖</div><div class="corner tr">❖</div>
      <div class="corner bl">❖</div><div class="corner br">❖</div>
    </div>
    <div id="titlePlate">
      <div class="t1">AETHRA</div>
      <div class="t2">TERRAS ANTIGAS, NOVOS DESTINOS</div>
    </div>
    <div id="mapQuote">"Mesmo após a Ruptura, a vida ainda encontra caminho."</div>
    <div id="mapCompass">
      <svg viewBox="0 0 100 100" width="84" height="84">
        <circle cx="50" cy="50" r="46" fill="rgba(26,20,16,.7)" stroke="#c99a4a" stroke-width="1.5"/>
        <circle cx="50" cy="50" r="38" fill="none" stroke="#8a6a34" stroke-width="1"/>
        <g stroke="#c99a4a" stroke-width="1">
          <line x1="50" y1="8" x2="50" y2="92"/>
          <line x1="8" y1="50" x2="92" y2="50"/>
        </g>
        <polygon points="50,14 44,50 50,50" fill="#c99a4a"/>
        <polygon points="50,14 56,50 50,50" fill="#8a6a34"/>
        <polygon points="50,86 44,50 50,50" fill="#8a6a34"/>
        <polygon points="50,86 56,50 50,50" fill="#c99a4a"/>
        <text x="50" y="14" fill="#e7d9b6" font-size="11" font-family="Cinzel,serif" text-anchor="middle">N</text>
        <text x="50" y="95" fill="#c9b98d" font-size="9" font-family="Cinzel,serif" text-anchor="middle">S</text>
        <text x="6" y="53" fill="#c9b98d" font-size="9" font-family="Cinzel,serif" text-anchor="middle">O</text>
        <text x="94" y="53" fill="#c9b98d" font-size="9" font-family="Cinzel,serif" text-anchor="middle">L</text>
      </svg>
    </div>
    <div id="mapLegend">
      <h4>LEGENDA</h4>
      <div class="lrow"><span class="sym">👑</span>Capital</div>
      <div class="lrow"><span class="sym">🏰</span>Cidade</div>
      <div class="lrow"><span class="sym">🏘️</span>Vila</div>
      <div class="lrow"><span class="sym">🛡️</span>Fortaleza</div>
      <div class="lrow"><span class="sym">🏚️</span>Ruínas Antigas</div>
      <div class="lrow"><span class="sym">◆</span>Ponto de Interesse</div>
      <div class="lrow"><span class="sym">━</span>Estrada Principal</div>
      <div class="lrow"><span class="sym">┄</span>Estrada Secundária</div>
      <div class="lrow"><span class="sym">≈</span>Rio / Lago</div>
      <div class="lrow"><span class="sym">▲</span>Montanha</div>
      <div class="lrow"><span class="sym">🌲</span>Floresta</div>
    </div>
    <div id="mapScale">0 &nbsp; 250 &nbsp; 500<div class="bar"></div>Léguas</div>
  </div>

  <div id="rightpanel">
    <div class="panel-section">
      <h3>Camadas</h3>
      <div id="layerList"></div>
    </div>
    <div class="panel-section" style="flex:1;">
      <h3>Seleção</h3>
      <div id="objectInfo"><div class="empty">Nada selecionado. Clique em um token, marcador ou desenho.</div></div>
    </div>
  </div>
</div>

<div id="bottombar">
  <div class="grp">
    <span>Zoom</span>
    <input type="range" id="zoomSlider" min="20" max="400" value="100">
    <span id="zoomLabel">100%</span>
  </div>
  <div class="grp" id="coords">x:0 y:0</div>
  <div class="grp">
    <button class="btn" id="btnGrid">▦ Grade</button>
    <button class="btn on" id="btnFogMaster">🌫 Névoa</button>
  </div>
  <div class="grp" id="gmFogControls">
    <button class="btn" id="btnRevealAll">Revelar Tudo</button>
    <button class="btn" id="btnClearExplore">Limpar Exploração</button>
  </div>
  <div class="spacer"></div>
  <div class="grp" id="statusMsg"></div>
</div>

<div id="modalOverlay">
  <div id="modalBox"></div>
</div>
<div class="toast" id="toast"></div>

<script>
"use strict";
/* =========================================================================
   AETHRA — mapa interativo de RPG de mesa
   Organização do código:
   1. Estado global / dados dos mapas (Mundo, Brumafria)
   2. Câmera (pan/zoom)
   3. Grade
   4. Névoa de guerra (Fog of War)
   5. Tokens
   6. Desenhos / marcadores (editor)
   7. Salvamento (localStorage + import/export JSON)
   8. Renderização (Canvas)
   9. Entrada (mouse/touch) e ligação com a interface
   ========================================================================= */

/* ---------------------- 1. ESTADO GLOBAL E DADOS DE MAPA ---------------------- */

const App = {
  mode: 'gm', // 'gm' | 'player'
  currentSceneId: 'world',
  tool: 'select',
  toastTimer: null,
  layers: {
    terrain:true, roads:true, water:true, buildings:true,
    locations:true, tokens:true, drawings:true, grid:false,
    fog:true, gmInfo:true
  },
  selected: null, // {kind:'token'|'marker'|'drawing', ref}
  drag: null,     // active drag/draw operation
  fogBrush: 46,
};

// ---- Definição geométrica do MUNDO (nível regional/mundial) ----
// Espaço de mundo: 1600 x 1000 unidades.
const WORLD = {
  id:'world',
  name:'Mundo de Aethra',
  w:1600, h:1000,
  gridSize:50,
  // Contorno único do continente (o "molde" sobre o qual as regiões se encaixam,
  // como no mapa de referência — um único bloco de terra, não ilhas separadas)
  continent:[[220,140],[420,90],[650,80],[820,110],[980,90],[1150,120],[1300,160],
             [1430,260],[1470,420],[1440,560],[1360,680],[1250,760],[1080,820],
             [900,850],[700,830],[560,800],[430,760],[300,680],[210,560],[160,420],[170,280]],
  oceanLabels:[
    {name:'MAR DE NÉVOAS', x:620, y:60},
    {name:'MAR DO OCASO', x:70, y:480},
    {name:'MAR SERENO', x:760, y:900},
    {name:'MAR DA RUPTURA', x:1440, y:780},
  ],
  islands:[
    {name:'Ilhas Serpente', x:250, y:760, cl:[[0,0],[30,10],[55,-6],[80,18]]},
    {name:'Ilhas Aurora', x:640, y:920, cl:[[0,0],[26,8],[50,-4]]},
    {name:'Ilhas Esquecidas', x:1020, y:930, cl:[[0,0],[24,-10],[48,6],[70,-8]]},
  ],
  regions:[
    {name:'Sylvarin', sub:'A Floresta Eterna', color:'#3f6b45',
     pts:[[220,140],[420,90],[480,180],[430,260],[400,340],[330,440],[300,560],[210,560],[160,420],[170,280]]},
    {name:'Khar-Durim', sub:'Montanhas de Ferro', color:'#6b7680',
     pts:[[420,90],[650,80],[820,110],[980,90],[1000,260],[850,330],[650,320],[480,260],[430,180]]},
    {name:'Morvath', sub:'Terras da Ruptura', color:'#4a2f3a',
     pts:[[980,90],[1150,120],[1300,160],[1430,260],[1470,420],[1380,460],[1250,400],[1120,320],[1000,260]]},
    {name:'Valedorn', sub:'O Reino dos Homens', color:'#a9863f',
